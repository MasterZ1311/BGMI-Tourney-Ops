{
  "name": "bgmi-tcc",
  "version": "1.0.0",
  "private": true,
  "description": "BGMI Tournament Control Center — The esports operations platform for Battlegrounds Mobile India",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node node_modules/esbuild/bin/esbuild scripts/test-runner.ts --bundle --platform=node --outfile=scripts/test-runner.bundle.js && node scripts/test-runner.bundle.js",
    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:clean": "node node_modules/esbuild/bin/esbuild scripts/clean-db.ts --bundle --platform=node --outfile=scripts/clean-db.bundle.js && node scripts/clean-db.bundle.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "papaparse": "^5.4.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
