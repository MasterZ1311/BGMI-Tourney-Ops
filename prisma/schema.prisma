datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("TOURNAMENT_ADMIN") // SUPER_ADMIN, TOURNAMENT_ADMIN, MATCH_ADMIN, SCOREKEEPER, OBSERVER
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tournament {
  id           String    @id @default(cuid())
  name         String
  organizer    String
  description  String?
  format       String    @default("GROUP_STAGE") // SINGLE_STAGE, GROUP_STAGE, GROUPS_AND_FINALS, QUALIFIERS_AND_FINALS, CUSTOM
  status       String    @default("DRAFT") // DRAFT, REGISTRATION, CHECK_IN, GROUPS_LOCKED, SCHEDULED, LIVE, RESULTS_REVIEW, COMPLETED, ARCHIVED
  startDate    DateTime
  endDate      DateTime
  venue        String?
  contactEmail String?
  isFinalized  Boolean   @default(false)
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  settings      TournamentSettings?
  scoringRule   ScoringRule?
  groups        Group[]
  teams         Team[]
  matches       Match[]
  attendances   Attendance[]
  penalties     Penalty[]
  disputes      Dispute[]
  auditLogs     AuditLog[]
  notifications Notification[]
}

model TournamentSettings {
  id                   String     @id @default(cuid())
  tournamentId         String     @unique
  tournament           Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  totalTeamsCap        Int        @default(64)
  squadSize            Int        @default(4)
  substitutesCap       Int        @default(2)
  maxTeamsPerGroup     Int        @default(16)
  matchDurationMinutes Int        @default(30)
  breakDurationMinutes Int        @default(15)
  noShowGraceMinutes   Int        @default(10)
  disputeWindowMinutes Int        @default(15)
  allowSubstitutions   Boolean    @default(true)
  rulesMarkdown        String?
}

model ScoringRule {
  id                String     @id @default(cuid())
  tournamentId      String     @unique
  tournament        Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name              String     @default("Official BGIS 10-Point System")
  placementPoints   String // JSON: {"1":10,"2":6,"3":5,"4":4,"5":3,"6":2,"7":1,"8":1,"9":0,...}
  killPointsPerElim Float      @default(1.0)
  wwcdBonus         Float      @default(0.0)
  tieBreakers       String     @default("[\"WWCD\",\"PLACEMENT_POINTS\",\"KILL_POINTS\",\"BEST_MATCH\",\"LAST_MATCH\"]") // JSON array
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Group {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  name         String // e.g. "Group A"
  isLocked     Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  teams   Team[]
  matches Match[]

  @@index([tournamentId])
}

model Team {
  id                 String     @id @default(cuid())
  tournamentId       String
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId            String?
  group              Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  name               String
  tag                String // 3-5 chars, e.g. "SOUL"
  logoUrl            String?
  captainName        String?
  captainPhone       String?
  captainEmail       String?
  verificationStatus String     @default("PENDING") // PENDING, VERIFIED, REJECTED
  status             String     @default("ACTIVE") // ACTIVE, DISQUALIFIED, WITHDRAWN
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  players     Player[]
  scores      TeamMatchScore[]
  matchTeams  MatchTeam[]
  attendances Attendance[]
  penalties   Penalty[]
  disputes    Dispute[]

  @@index([tournamentId])
  @@index([groupId])
}

model Player {
  id           String   @id @default(cuid())
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  name         String
  ign          String // In-Game Name
  characterId  String // BGMI UID
  role         String   @default("ASSAULTER") // CAPTAIN, ASSAULTER, SNIPER, SUPPORT, IGL
  isSubstitute Boolean  @default(false)
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([teamId])
  @@index([characterId])
}

model Match {
  id                 String     @id @default(cuid())
  tournamentId       String
  tournament         Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupId            String?
  group              Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)
  matchNumber        Int
  title              String // e.g. "Match 1 - Group A"
  map                String     @default("ERANGEL") // ERANGEL, MIRAMAR, SANHOK, VIKENDI, RONDO
  perspective        String     @default("TPP") // TPP, FPP
  scheduledStartTime DateTime
  actualStartTime    DateTime?
  actualEndTime      DateTime?
  status             String     @default("SCHEDULED") // SCHEDULED, READY, OPEN, LIVE, COMPLETED, VERIFIED, PUBLISHED, CANCELLED
  resultStatus       String     @default("DRAFT") // DRAFT, SUBMITTED, VERIFIED, PUBLISHED
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  room        Room?
  matchTeams  MatchTeam[]
  scores      TeamMatchScore[]
  attendances Attendance[]
  penalties   Penalty[]
  disputes    Dispute[]

  @@index([tournamentId])
  @@index([groupId])
}

model Room {
  id        String   @id @default(cuid())
  matchId   String   @unique
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  roomName  String
  roomId    String? // BGMI In-Game Room ID
  password  String? // BGMI In-Game Room Password
  status    String   @default("NOT_CREATED") // NOT_CREATED, READY, OPEN, LIVE, COMPLETED, CLOSED
  updatedAt DateTime @updatedAt
}

model MatchTeam {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slotNumber Int?

  @@unique([matchId, teamId])
  @@index([matchId])
  @@index([teamId])
}

model TeamMatchScore {
  id              String   @id @default(cuid())
  matchId         String
  match           Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  placement       Int // 1-25
  kills           Int      @default(0)
  placementPoints Float    @default(0.0)
  killPoints      Float    @default(0.0)
  bonusPoints     Float    @default(0.0)
  penaltyPoints   Float    @default(0.0)
  totalPoints     Float    @default(0.0)
  isWwcd          Boolean  @default(false)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([matchId, teamId])
  @@index([matchId])
  @@index([teamId])
}

model Attendance {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchId      String?
  match        Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  status       String     @default("ABSENT") // PRESENT, ABSENT, LATE, DISQUALIFIED, WITHDRAWN
  checkedInBy  String?
  timestamp    DateTime   @default(now())

  @@index([tournamentId])
  @@index([teamId])
  @@index([matchId])
}

model Penalty {
  id             String     @id @default(cuid())
  tournamentId   String
  tournament     Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId         String
  team           Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchId        String?
  match          Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  pointsDeducted Float
  reason         String
  evidenceUrl    String?
  status         String     @default("ACTIVE") // ACTIVE, VOIDED
  issuedBy       String     @default("Admin")
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([tournamentId])
  @@index([teamId])
  @@index([matchId])
}

model Dispute {
  id              String     @id @default(cuid())
  tournamentId    String
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId          String
  team            Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matchId         String?
  match           Match?     @relation(fields: [matchId], references: [id], onDelete: SetNull)
  category        String     @default("SCORING")
  description     String
  evidenceUrl     String?
  status          String     @default("OPEN") // OPEN, UNDER_REVIEW, ACCEPTED, REJECTED, RESOLVED
  resolutionNotes String?
  resolvedBy      String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([tournamentId])
  @@index([teamId])
  @@index([matchId])
}

model AuditLog {
  id           String      @id @default(cuid())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String?
  action       String
  entityType   String
  entityId     String
  beforeState  String? // JSON
  afterState   String? // JSON
  reason       String?
  createdAt    DateTime    @default(now())

  @@index([tournamentId])
  @@index([userId])
  @@index([entityType, entityId])
}

model Notification {
  id           String      @id @default(cuid())
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  title        String
  message      String
  type         String      @default("INFO") // INFO, SUCCESS, WARNING, DANGER
  isRead       Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([tournamentId])
}
