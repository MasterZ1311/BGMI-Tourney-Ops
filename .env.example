# ==============================================================================
# BGMI Tournament Control Center (TCC) — Environment Variables Template
# Copy this file to .env or .env.local and adjust values for your environment.
# DO NOT COMMIT REAL PRODUCTION SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Connection Configuration
# ------------------------------------------------------------------------------
# Default: SQLite file-based database for zero-configuration local development & demo runs.
DATABASE_URL="file:./dev.db"

# Optional: PostgreSQL Connection (for high-scale production deployments)
# When using PostgreSQL, ensure 'provider = "postgresql"' is set in prisma/schema.prisma
# DATABASE_URL="postgresql://bgmi:bgmipassword@localhost:5432/bgmi_tcc?schema=public"

# ------------------------------------------------------------------------------
# 2. Server & Runtime Configuration
# ------------------------------------------------------------------------------
# Port on which the application server listens
PORT=3000

# Host IP binding (use 0.0.0.0 inside containers to accept external traffic)
HOSTNAME="0.0.0.0"

# Application environment ('development' | 'production' | 'test')
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 3. Application URLs
# ------------------------------------------------------------------------------
# Canonical public-facing application URL (used in display links, exports, and assets)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication base URL (should match NEXT_PUBLIC_APP_URL)
NEXTAUTH_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 4. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# Cryptographic secret used for session tokens, cookies, and staff signatures.
# In production, generate a secure 32+ character random string:
# Run: openssl rand -base64 32
NEXTAUTH_SECRET="bgmi-tcc-replace-with-secure-32-char-random-string"

# ------------------------------------------------------------------------------
# 5. Tournament Operations & Demo Flags
# ------------------------------------------------------------------------------
# Enables simulated SUPER_ADMIN demo session for rapid evaluation and local testing.
# Set to 'false' in production environments to enforce full authentication checks.
ENABLE_DEMO_AUTH="true"
