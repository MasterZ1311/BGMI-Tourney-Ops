# Database connection (SQLite default for out-of-the-box local development & zero-setup demo)
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/bgmi_tcc?schema=public"
DATABASE_URL="file:./dev.db"

# Next.js & App configuration
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret token for authentication & staff operations
NEXTAUTH_SECRET="bgmi-tournament-super-secret-key-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"
